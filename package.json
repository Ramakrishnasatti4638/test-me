{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "A URL shortener application",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "nanoid": "^4.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
