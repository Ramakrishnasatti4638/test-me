NODE_ENV=development
PORT=3000

# CORS — the origin of the frontend that will call this API
CLIENT_ORIGIN=http://localhost:5173

# JWT signing secret. Use `openssl rand -hex 64` in production.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt cost factor (10 = fast, 12 = default-recommended)
BCRYPT_ROUNDS=12

# Rate limit on /api/auth/* (per 15-minute window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# 'memory' (default, dev) or 'file' (persisted JSON)
USER_STORE=memory
USER_FILE=.data/users.json
